# ─── LLM ────────────────────────────────────────────────────────────────────
# Leave blank to use the built-in MockLLM provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# ─── Search ─────────────────────────────────────────────────────────────────
# Leave blank to use the DuckDuckGo fallback (no key required).
SERPAPI_API_KEY=

# ─── TTS ────────────────────────────────────────────────────────────────────
# TTS_ENGINE can be: pyttsx3 | gtts | none
# "none" tells the frontend to use browser SpeechSynthesis.
TTS_ENGINE=gtts

# ─── STT ────────────────────────────────────────────────────────────────────
# STT_ENGINE can be: whisper | faster-whisper | none
# "none" falls back to the text input field in the UI.
STT_ENGINE=none
WHISPER_MODEL=base

# ─── Emotion ─────────────────────────────────────────────────────────────────
# EMOTION_ENGINE can be: transformers | vader | heuristic
EMOTION_ENGINE=vader

# ─── Server ─────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
